local lastTeleportTime = 0
local lastJumpPowerTime = 0
local lastSlideTime = 0
local lastCarryTime = 0

local function HandleTeleportWalk()
    if not Config.TeleportEnabled then return end
    
    local currentTime = tick()
    if currentTime - lastTeleportTime < 0.05 then return end
    lastTeleportTime = currentTime
    
    local Character = LocalPlayer.Character
    if not Character or not Character.PrimaryPart then return end
    
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid or Humanoid.Health <= 0 then return end
    
    if Humanoid.MoveDirection.Magnitude > 0 then
        pcall(function()
            Character:TranslateBy(Humanoid.MoveDirection * Config.WalkSpeed * 0.05)
        end)
    end
end

local lastJumpHeight = 0
local function HandleEnhancedJump()
    if not Config.EnhancedJumpEnabled then return end
    
    if lastJumpHeight == Config.JumpHeight then return end
    lastJumpHeight = Config.JumpHeight
    
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid then return end
    
    pcall(function()
        Humanoid.JumpPower = Config.JumpHeight
        Humanoid.UseJumpPower = true
    end)
end

local function HandleAutoJump()
    if not Config.AutoJumpEnabled then return end
    
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid or Humanoid.Health <= 0 then return end
    
    if Humanoid:GetState() == Enum.HumanoidStateType.Running then
        pcall(function()
            Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end
end

local SPEED_TRIGGER = 33
local function HandleFrontJump()
    if not Config.FrontJumpEnabled then return end
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
        local root = char.HumanoidRootPart
        local humanoid = char.Humanoid
        local vel = root.AssemblyLinearVelocity
        local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
        
        if speed >= SPEED_TRIGGER and humanoid.FloorMaterial ~= Enum.Material.Air then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end

local function HandleInfiniteSlide()
    if not Config.InfiniteSlideEnabled then return end
    
    local currentTime = tick()
    if currentTime - lastSlideTime < 0.1 then return end
    lastSlideTime = currentTime
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
    if humanoidRootPart then
        pcall(function()
            local vel = humanoidRootPart.AssemblyLinearVelocity
            if vel.Magnitude > 10 then
                humanoidRootPart.AssemblyLinearVelocity = vel + (humanoidRootPart.CFrame.LookVector * 1)
            end
        end)
    end
end

local CARRY_DISTANCE = 15
local function HandleAutoCarry()
    if not Config.AutoCarryEnabled then return end
    
    local currentTime = tick()
    if currentTime - lastCarryTime < 0.2 then return end
    lastCarryTime = currentTime
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local myRoot = char.HumanoidRootPart
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local targetChar = p.Character
                local targetRoot = targetChar.HumanoidRootPart
                local dist = (myRoot.Position - targetRoot.Position).Magnitude
                
                if dist <= CARRY_DISTANCE and targetChar:FindFirstChild("Downed") then
                    pcall(function()
                        local events = ReplicatedStorage:FindFirstChild("Events")
                        if events and events:FindFirstChild("Interact") then
                            events.Interact:FireServer(targetChar, "Carry")
                        end
                    end)
                end
            end
        end
    end
end

