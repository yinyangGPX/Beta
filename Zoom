local function formatDuration(totalSeconds)
    totalSeconds = math.floor(totalSeconds)
    local h = math.floor(totalSeconds / 3600)
    local m = math.floor((totalSeconds % 3600) / 60)
    local s = totalSeconds % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

-- Dibuja el ícono de una pestaña dentro de "container" (un Frame chico,
-- pensado para 18x18). Devuelve { setColor = function(color) ... } para
-- poder recolorearlo cuando la pestaña se selecciona/deselecciona.
--
-- iconSpec puede ser:
--   * Un nombre de ícono dibujado: "aimbot", "eye", "shield", "sword",
--     "teleport", "box", "move" (no requiere subir nada a Roblox).
--   * Un Asset ID de Roblox, como número (123456) o string ("123456",
--     "rbxassetid://123456"), si el script ya tiene su propia imagen.
--     OJO: para que el ícono cambie de color al seleccionar la pestaña
--     (como los dibujados), la imagen debería ser blanca/plana sobre
--     fondo transparente; si es una imagen a color, el tinte se va a
--     mezclar con sus colores originales.
local function drawTabIcon(container, iconSpec, initialColor)
    if type(iconSpec) == "number" or (type(iconSpec) == "string" and (iconSpec:match("^%d+$") or iconSpec:match("^rbxassetid://") or iconSpec:match("^rbxthumb://"))) then
        local content = iconSpec
        if type(iconSpec) == "number" or (type(iconSpec) == "string" and iconSpec:match("^%d+$")) then
            content = "rbxassetid://" .. tostring(iconSpec)
        end
        local Image = mk("ImageLabel", {
            Parent = container,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Image = content,
            ImageColor3 = initialColor,
            ZIndex = 9
        })
        return { setColor = function(color) Image.ImageColor3 = color end }
    elseif type(iconSpec) == "string" and iconSpec:match("^https?://") then
        -- Carga asíncrona con getcustomasset — mismo patrón que la imagen de
        -- fondo y Tab:CreateRemoteImage. La imagen debe ser blanca/plana sobre
        -- fondo transparente para que el tinte al seleccionar funcione.
        local Image = mk("ImageLabel", {
            Parent = container,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Image = "",
            ImageColor3 = Color3.new(1, 1, 1),
            ZIndex = 9
        })
        task.spawn(function()
            local fileName = iconSpec:match("/([^/]+)$") or "tab_icon.png"
            local cacheFile = "ZeroMobile_Icon_" .. fileName
            if type(writefile) ~= "function" or type(isfile) ~= "function" then return end
            local cachedOk, cachedExists = pcall(isfile, cacheFile)
            if not (cachedOk and cachedExists) then
                local downloadOk, data = pcall(function()
                    return game:HttpGet(iconSpec, true)
                end)
                if not downloadOk or type(data) ~= "string" or #data < 10 then return end
                if not pcall(writefile, cacheFile, data) then return end
            end
            if type(getcustomasset) ~= "function" then return end
            local assetOk, assetResult = pcall(getcustomasset, cacheFile)
            if assetOk and type(assetResult) == "string" then
                Image.Image = assetResult
            end
        end)
        return { setColor = function() end }
    end

    local strokes, fills = {}, {}

    local function ring(sizeRatio)
        local Ring = mk("Frame", {
            Parent = container,
            Size = UDim2.new(sizeRatio, 0, sizeRatio, 0),
            Position = UDim2.new((1 - sizeRatio) / 2, 0, (1 - sizeRatio) / 2, 0),
            BackgroundTransparency = 1,
            ZIndex = 9
        })
        corner(Ring, 999)
        table.insert(strokes, stroke(Ring, initialColor, 1.5, 0))
        return Ring
    end

    local function dot(sizeRatio)
        local Dot = mk("Frame", {
            Parent = container,
            Size = UDim2.new(sizeRatio, 0, sizeRatio, 0),
            Position = UDim2.new((1 - sizeRatio) / 2, 0, (1 - sizeRatio) / 2, 0),
            BackgroundColor3 = initialColor,
            ZIndex = 9
        })
        corner(Dot, 999)
        table.insert(fills, Dot)
        return Dot
    end

    local function bar(widthRatio, heightRatio, posX, posY, rotation)
        local Bar = mk("Frame", {
            Parent = container,
            Size = UDim2.new(widthRatio, 0, heightRatio, 0),
            Position = UDim2.new(posX, 0, posY, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = initialColor,
            Rotation = rotation or 0,
            ZIndex = 9
        })
        corner(Bar, 999)
        table.insert(fills, Bar)
        return Bar
    end

    if iconSpec == "aimbot" then
        ring(0.85)
        bar(0.9, 0.09, 0.5, 0.5, 0)
        bar(0.09, 0.9, 0.5, 0.5, 0)
        dot(0.16)
    elseif iconSpec == "eye" then
        local Eye = mk("Frame", {
            Parent = container,
            Size = UDim2.new(1, 0, 0.55, 0),
            Position = UDim2.new(0, 0, 0.225, 0),
            BackgroundTransparency = 1,
            ZIndex = 9
        })
        corner(Eye, 999)
        table.insert(strokes, stroke(Eye, initialColor, 1.5, 0))
        dot(0.28)
    elseif iconSpec == "shield" then
        local Badge = mk("Frame", {
            Parent = container,
            Size = UDim2.new(0.85, 0, 0.85, 0),
            Position = UDim2.new(0.075, 0, 0.075, 0),
            BackgroundTransparency = 1,
            ZIndex = 9
        })
        corner(Badge, 6)
        table.insert(strokes, stroke(Badge, initialColor, 1.5, 0))
    elseif iconSpec == "sword" then
        bar(0.95, 0.12, 0.5, 0.5, 45)
        bar(0.34, 0.12, 0.32, 0.62, -45)
    elseif iconSpec == "teleport" then
        local Diamond = mk("Frame", {
            Parent = container,
            Size = UDim2.new(0.6, 0, 0.6, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Rotation = 45,
            BackgroundTransparency = 1,
            ZIndex = 9
        })
        corner(Diamond, 4)
        table.insert(strokes, stroke(Diamond, initialColor, 1.5, 0))
        dot(0.14)
    elseif iconSpec == "box" then
        local Body = mk("Frame", {
            Parent = container,
            Size = UDim2.new(0.85, 0, 0.85, 0),
            Position = UDim2.new(0.075, 0, 0.075, 0),
            BackgroundTransparency = 1,
            ZIndex = 9
        })
        corner(Body, 3)
        table.insert(strokes, stroke(Body, initialColor, 1.5, 0))
        bar(0.85, 0.06, 0.5, 0.5, 0)
    elseif iconSpec == "move" then
        bar(0.9, 0.1, 0.5, 0.5, 0)
        bar(0.1, 0.9, 0.5, 0.5, 0)
    else
        -- nombre de ícono desconocido: un punto simple como placeholder,
        -- para no romper nada si alguien escribe mal el nombre
        dot(0.3)
    end

    return {
        setColor = function(color)
            for _, s in ipairs(strokes) do s.Color = color end
            for _, f in ipairs(fills) do f.BackgroundColor3 = color end
        end
    }
end

--// Objeto principal de la UI
local ZeroUI = {}
ZeroUI.__index = ZeroUI

function ZeroUI:CreateWindow(title_text)
    -- Conexiones a servicios globales (UserInputService) que NO se
    -- desconectan solas al destruir la GUI (a diferencia de los eventos
    -- de los propios botones). Se guardan para poder limpiarlas en
    -- Window:Destroy() y evitar conexiones huérfanas.
    local globalConnections = {}
    local function track(conn)
        table.insert(globalConnections, conn)
        return conn
    end

    local ScreenGui = mk("ScreenGui", {
        Name = "ZeroMobile",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 100
    }, LocalPlayer:WaitForChild("PlayerGui"))

    -- Botón flotante para ocultar/mostrar la UI (zbtn)
    local ToggleButton = mk("TextButton", {
        Name = "ToggleButton",
        Size = UDim2.new(0, 104, 0, 104),
        Position = UDim2.new(0, 24, 0, 70),
        BackgroundTransparency = 1, -- ya no depende del círculo blanco
        Text = "",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 17,
        ZIndex = 30,
    }, ScreenGui)
    mk("ImageLabel", {
        Name = "Icon",
        Parent = ToggleButton,
        Size = UDim2.new(0, 100, 0, 100), -- mucho más grande (antes 60x60)
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 1,
        Image = "rbxassetid://82543804521292",
        ZIndex = 31,
    })

    -- Efecto de "apretado" al tocarlo para dar feedback táctil (se quitó
    -- la respiración continua idle que pedían sacar). Se usa un UIScale
    -- (no se toca .Size directamente) para no interferir con el cálculo
    -- de posición del arrastre, que sigue usando ToggleButton.Position.
    local ToggleScale = mk("UIScale", {Scale = 1}, ToggleButton)

    ToggleButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(ToggleScale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.88}):Play()
        end
    end)
    ToggleButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(ToggleScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end
    end)

    -- Ventana Principal de la UI
    local Main = mk("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 420, 0, 340),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = true,
        ZIndex = 5
    }, ScreenGui)
    corner(Main, 10)
    stroke(Main, Theme.Stroke, 1.5)
    -- Simulación de "sombra" con un stroke exterior semitransparente
    stroke(Main, Color3.fromRGB(0, 0, 0), 4, 0.85)

    -- FIX TAMAÑO: en vez de UIScale (que rompía el ScrollingFrame de los
    -- tabs), se recalcula Main.Size directamente en offsets según el
    -- tamaño real de pantalla. Como los paneles internos (TabList,
    -- ContentArea) ya usan Scale en su alto/ancho relativo a Main, se
    -- ajustan solos sin necesidad de una capa de escalado extra.
    local shownSize = UDim2.new(0, 420, 0, 340)
    local function updateWindowSize()
        local screen = ScreenGui.AbsoluteSize
        if screen.X <= 0 or screen.Y <= 0 then return end
        local maxWidth = math.clamp(screen.X * 0.85, 260, 420)
        local maxHeight = math.clamp(screen.Y * 0.55, 220, 340)
        shownSize = UDim2.new(0, maxWidth, 0, maxHeight)
        if Main.Visible then
            Main.Size = shownSize
        end
    end
    updateWindowSize()
    ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateWindowSize)

    -- Funcionalidad Toggle (ocultar/mostrar Main)
    local uiVisible = true
    ToggleButton.MouseButton1Click:Connect(function()
        uiVisible = not uiVisible
        if uiVisible then
            Main.Visible = true
            Main.Size = UDim2.new(0, 0, 0, 0)
            TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {Size = shownSize}):Play()
        else
            local tw = TweenService:Create(Main, TweenInfo.new(0.18, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
            tw:Play()
            tw.Completed:Wait()
            Main.Visible = false
        end
    end)

    -- Drag para ToggleButton
    do
        local drag = false
        local dragStart, startPos
        ToggleButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                drag = true
                dragStart = input.Position
                startPos = ToggleButton.Position
            end
        end)
        track(UserInputService.InputChanged:Connect(function(input)
            if drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                ToggleButton.Position = UDim2.new(0, startPos.X.Offset + delta.X, 0, startPos.Y.Offset + delta.Y)
            end
        end))
        track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                drag = false
            end
        end))
    end

    -- Barra Superior de la Ventana (topbar - arrastrable)
    local TopBar = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1, -- antes Theme.Background sólido; ahora deja ver la imagen de fondo
        ZIndex = 6,
    }, Main)
    corner(TopBar, 10)
    mk("Frame", {Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = Theme.Stroke, ZIndex = 7}, TopBar)

    mk("TextLabel", {
        Size = UDim2.new(1, -50, 1, 0),
        Position = UDim2.new(0, 15, 0, 0),
        BackgroundTransparency = 1,
        Text = title_text or "ZERO UI",
        TextColor3 = Theme.Text,
        Font = Theme.Font,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 7
    }, TopBar)

    -- Drag para la Ventana Principal
    do
        local drag = false
        local dragStart, startPos
        TopBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                drag = true
                dragStart = input.Position
                startPos = Main.Position
            end
        end)
        track(UserInputService.InputChanged:Connect(function(input)
            if drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end))
        track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                drag = false
            end
        end))
    end

    -- Contenedor del cuerpo (body)
    local Body = mk("Frame", {
        Size = UDim2.new(1, 0, 1, -40),
        Position = UDim2.new(0, 0, 0, 40),
        BackgroundTransparency = 1,
        ZIndex = 6
    }, Main)

    -- Sidebar de Tabs
    local TabList = mk("ScrollingFrame", {
        Size = UDim2.new(0, 110, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Theme.Secondary,
        BorderSizePixel = 0,
        ScrollBarThickness = 3, -- antes 0 (invisible): si hay muchos tabs, ahora se nota que se puede deslizar
        ElasticBehavior = Enum.ElasticBehavior.Never, -- evita rebote elástico que generaba espacio fantasma
        CanvasPosition = Vector2.new(0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, -- FIX: se removió CanvasSize manual que competía con esto
        ZIndex = 7
    }, Body)
    corner(TabList, 10) -- FIX ESQUINA: TabList es opaco y llega hasta el borde de Main;
    -- sin su propio UICorner, su esquina cuadrada tapa la esquina redondeada de Main
    -- (ClipsDescendants recorta en rectángulo, no respeta el redondeado del padre).
    mk("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Top, -- FIX: ancla arriba, evita que floten
    }, TabList)
    mk("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, TabList)
    -- FIX ESPACIO VACÍO: esta línea divisoria vivía dentro de TabList, que tiene
    -- UIListLayout. Al ser hijo de un contenedor con UIListLayout, Roblox ignora su
    -- Position manual y la trata como el primer ítem de la lista de pestañas; como su
    -- Size es (0,1,1,0) (100% del alto de TabList), ocupaba toda la columna y empujaba
    -- los botones reales de pestaña fuera del área visible. Se reparenta a Body (que no
    -- tiene UIListLayout) y se fija su posición en offsets absolutos para que quede en
    -- el mismo lugar visual: pegada al borde derecho de TabList (110px de ancho).
    mk("Frame", {Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(0, 109, 0, 0), BackgroundColor3 = Theme.Stroke, ZIndex = 8}, Body)

    -- Contenedor de Páginas de Tabs
    local ContentArea = mk("Frame", {
        Size = UDim2.new(1, -110, 1, 0),
        Position = UDim2.new(0, 110, 0, 0),
        BackgroundTransparency = 1,
        ZIndex = 7
    }, Body)
    mk("UIPadding", {PaddingTop = UDim.new(0, 15), PaddingLeft = UDim.new(0, 15), PaddingRight = UDim.new(0, 15), PaddingBottom = UDim.new(0, 15)}, ContentArea)

    -- Imagen de fondo del panel (reemplaza visualmente el negro sólido).
    -- Vive DENTRO de ContentArea (no de Main): si fuera hijo de Main, el
    -- TabList (110px, opaco) tapa media ventana y solo asoma una franja muy
    -- angosta. Agrandada +15px por lado para desbordar el UIPadding de
    -- ContentArea y centrada con AnchorPoint, mismo patrón que usa la
    -- librería de referencia (Zin) para su BackgroundArt.
    -- Se descarga con el mismo patrón ya verificado que usa Tab:CreateRemoteImage
    -- (isfile -> game:HttpGet -> writefile -> getcustomasset), no un rbxassetid
    -- estático, porque ese ID no se pudo confirmar que sea válido.
    local BackgroundImage = mk("ImageLabel", {
        Name = "BackgroundImage",
        Parent = ContentArea,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1, 30, 1, 30),
        BackgroundTransparency = 1,
        Image = "",
        ScaleType = Enum.ScaleType.Crop,
        ZIndex = 5,
    })
    task.spawn(function()
        local imageUrl = "https://raw.githubusercontent.com/xonokeo-art/Rozek/main/8764727fad9ea6535fd7579d8c83af24%20(1).jpg"
        local cacheFileName = "ZeroMobile_Background_Image.jpg"

        if type(writefile) ~= "function" or type(isfile) ~= "function" or type(readfile) ~= "function" then
            return
        end

        local cachedOk, cachedExists = pcall(isfile, cacheFileName)
        if not (cachedOk and cachedExists) then
            local downloadOk, data = pcall(function()
                return game:HttpGet(imageUrl, true)
            end)
            if not downloadOk or type(data) ~= "string" or #data < 10 then
                return
            end
            local writeOk = pcall(writefile, cacheFileName, data)
            if not writeOk then
                return
            end
        end

        if type(getcustomasset) ~= "function" then
            return
        end

        local assetOk, assetResult = pcall(getcustomasset, cacheFileName)
        if assetOk and type(assetResult) == "string" then
            BackgroundImage.Image = assetResult
        end
    end)

    -- Capa superior para los popups de los dropdowns. Se parentea
    -- directo a Main (no a una TabPage) y con un ZIndex muy alto, para
    -- que la lista desplegable NUNCA quede recortada por el scroll de
    -- la página (las ScrollingFrame recortan su contenido al área
    -- visible, y un dropdown que se abre cerca del final de la página
    -- quedaría cortado si viviera adentro de esa misma ScrollingFrame).
    local Overlay = mk("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 200,
    }, Main)

    -- Solo puede haber un dropdown abierto a la vez en toda la ventana.
    local currentDropdownClose = nil

    -- Lógica compartida entre CreateDropdown (una opción) y
    -- CreateMultiDropdown (varias opciones): posiciona el popup justo
    -- debajo del control, calcula su alto (con tope y scroll propio si
    -- hay muchas opciones) y maneja el cierre al tocar afuera.
    local function attachDropdownBehavior(Holder, Click, Chevron, optionsCount, buildPopupContents)
        local isOpen = false
        local closePopup

        local function open()
            if currentDropdownClose then currentDropdownClose() end
            isOpen = true
            Chevron.Text = "^"

            local backdrop = mk("TextButton", {
                Parent = Overlay,
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                ZIndex = 201
            })

            local relX = Holder.AbsolutePosition.X - Main.AbsolutePosition.X
            local relY = Holder.AbsolutePosition.Y - Main.AbsolutePosition.Y + Holder.AbsoluteSize.Y + 4
            local itemH = 32
            local maxH = 160
            local contentH = math.max(optionsCount, 1) * (itemH + 4) + 8
            local popupH = math.min(contentH, maxH)

            local Popup = mk("ScrollingFrame", {
                Parent = Overlay,
                Position = UDim2.new(0, relX, 0, relY),
                Size = UDim2.new(0, Holder.AbsoluteSize.X, 0, popupH),
                BackgroundColor3 = Theme.Background,
                BorderSizePixel = 0,
                ScrollBarThickness = 3,
                ElasticBehavior = Enum.ElasticBehavior.Never,
                CanvasPosition = Vector2.new(0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ZIndex = 202
            })
            corner(Popup, 6)
            stroke(Popup, Theme.Stroke, 1.5, 0)
            mk("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, Popup)
            mk("UIPadding", {
                PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
                PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4)
            }, Popup)

            closePopup = function()
                isOpen = false
                Chevron.Text = "v"
                backdrop:Destroy()
                Popup:Destroy()
                currentDropdownClose = nil
            end
            currentDropdownClose = closePopup
            backdrop.MouseButton1Click:Connect(function() closePopup() end)

            buildPopupContents(Popup, closePopup)
        end

        Click.MouseButton1Click:Connect(function()
            if isOpen then
                if closePopup then closePopup() end
            else
                open()
            end
        end)
    end

    local Window = setmetatable({}, ZeroUI)
    Window.Tabs = {}

    function Window:CreateTab(name, icon)
        local TabButton = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = Theme.AccentOff,
            Text = "",
            ZIndex = 8
        }, TabList)
        corner(TabButton, 6)
        resetScrollTop(TabList) -- FIX SCROLL: garantiza que el sidebar siempre arranque arriba

        -- Si se pasó un ícono, se deja lugar a la izquierda para dibujarlo
        -- y el texto se corre y queda alineado a la izquierda; si no hay
        -- ícono, el texto ocupa todo el ancho y queda centrado (como antes).
        local iconHandle = nil
        local labelOffsetX = 8
        if icon then
            local IconHolder = mk("Frame", {
                Parent = TabButton,
                Size = UDim2.new(0, 18, 0, 18),
                Position = UDim2.new(0, 8, 0.5, -9),
                BackgroundTransparency = 1,
                ZIndex = 9
            })
            iconHandle = drawTabIcon(IconHolder, icon, Theme.TextDim)
            labelOffsetX = 32
        end

        local NameLabel = mk("TextLabel", {
            Parent = TabButton,
            Size = UDim2.new(1, -(labelOffsetX + 8), 1, 0),
            Position = UDim2.new(0, labelOffsetX, 0, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = Theme.Text,
            Font = Theme.Font,
            TextSize = 13,
            TextXAlignment = icon and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd, -- por si otro script usa nombres de tab largos
            ZIndex = 9
        })

        local TabPage = mk("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, -- FIX: ScrollingFrame es opaco blanco por defecto si no se fija esto
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ElasticBehavior = Enum.ElasticBehavior.Never,
            CanvasPosition = Vector2.new(0, 0),
            Visible = false,
            ZIndex = 8,
            AutomaticCanvasSize = Enum.AutomaticSize.Y, -- FIX: idem, sin CanvasSize manual
        }, ContentArea)
        mk("UIListLayout", {
            Padding = UDim.new(0, 10),
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Top,
        }, TabPage)

        local Tab = {Button = TabButton, Page = TabPage}

        local function Select()
            for _, t in pairs(Window.Tabs) do
                t.Page.Visible = false
                t.NameLabel.TextColor3 = Theme.Text
                t.Button.BackgroundColor3 = Theme.AccentOff
                if t.IconHandle then t.IconHandle.setColor(Theme.TextDim) end
            end
            TabPage.Visible = true
            NameLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
            TabButton.BackgroundColor3 = Theme.Accent
            if iconHandle then iconHandle.setColor(Color3.fromRGB(0, 0, 0)) end
        end

        Tab.NameLabel = NameLabel
        Tab.IconHandle = iconHandle

        TabButton.MouseButton1Click:Connect(Select)
        if #Window.Tabs == 0 then Select() end
        table.insert(Window.Tabs, Tab)

        --// Elementos de Tab
        function Tab:CreateButton(text, callback)
            local Btn = mk("TextButton", {
                Size = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = Theme.Secondary,
                Text = text,
                TextColor3 = Theme.Text,
                Font = Theme.Font,
                TextSize = 14,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 9
            }, TabPage)
            corner(Btn, 6)
            stroke(Btn, Color3.fromRGB(0,0,0), 1, 0.6) -- FIX: menos transparente, más visible
            resetScrollTop(TabPage) -- FIX SCROLL: la página siempre arranca mostrando el primer elemento

            Btn.MouseButton1Click:Connect(function()
                TweenService:Create(Btn, TweenInfo.new(0.08), {BackgroundColor3 = Theme.Accent, TextColor3 = Color3.fromRGB(0,0,0)}):Play()
                task.wait(0.08)
                TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Secondary, TextColor3 = Theme.Text}):Play()
                pcall(callback)
            end)
            return Btn
        end

        function Tab:CreateToggle(text, default, callback)
            local state = default or false
            local Holder = mk("Frame", {
                Parent = TabPage,
                Size = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = Theme.Secondary,
                ZIndex = 9
            })
            corner(Holder, 6)
            stroke(Holder, Color3.fromRGB(0,0,0), 1, 0.6)

            mk("TextLabel", {
                Parent = Holder,
                Size = UDim2.new(1, -60, 1, 0),
                Position = UDim2.new(0, 12, 0, 0),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.Text,
                Font = Theme.Font,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 10
            }, Holder)

            local Switch = mk("Frame", {
                Parent = Holder,
                Size = UDim2.new(0, 40, 0, 20),
                Position = UDim2.new(1, -50, 0.5, -10),
                BackgroundColor3 = state and Theme.ToggleOn or Theme.AccentOff,
                ZIndex = 10
            })
            corner(Switch, 999)

            local Knob = mk("Frame", {
                Parent = Switch,
                Size = UDim2.new(0, 16, 0, 16),
                Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
                BackgroundColor3 = Color3.new(1, 1, 1),
                ZIndex = 11
            })
            corner(Knob, 999)

            local Click = mk("TextButton", {Parent = Holder, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 12})
            Click.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(Switch, TweenInfo.new(0.15), {BackgroundColor3 = state and Theme.ToggleOn or Theme.AccentOff}):Play()
                TweenService:Create(Knob, TweenInfo.new(0.15), {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
                pcall(callback, state)
            end)
            resetScrollTop(TabPage) -- FIX SCROLL: la página siempre arranca mostrando el primer elemento
        end

        -- Toggle flotante con candado (mismo patrón que Tab:CreateFloatingToggle
        -- de la librería Zin, simplificado: sin favoritos, combo ni keybind,
        -- que Zero Mobile no tiene). El botón ↗ crea/destruye una píldora
        -- flotante y arrastrable; el candado (mismos íconos que usa Zin)
        -- fija o libera esa píldora para que no se mueva por accidente.
        function Tab:CreateFloatingToggle(text, default, callback)
            local state = default or false
            local isFloating = false
            local isLocked = false
