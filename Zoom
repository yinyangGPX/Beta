-- Paletas para el modo oscuro. Solo se listan los colores que cambian
-- entre temas (fondo, texto, etc.); el negro de acento y el verde del
-- toggle se mantienen iguales en ambos para que la pestaña seleccionada
-- y los toggles activos sigan contrastando bien sin importar el tema.
local LightPalette = {
    Background = Color3.fromRGB(255, 255, 255),
    Secondary  = Color3.fromRGB(232, 232, 232),
    AccentOff  = Color3.fromRGB(200, 200, 200),
    Text       = Color3.fromRGB(0, 0, 0),
    TextDim    = Color3.fromRGB(120, 120, 120),
    Stroke     = Color3.fromRGB(0, 0, 0),
}
local DarkPalette = {
    Background = Color3.fromRGB(24, 24, 27),
    Secondary  = Color3.fromRGB(40, 40, 45),
    AccentOff  = Color3.fromRGB(40, 40, 46),
    Text       = Color3.fromRGB(240, 240, 240),
    TextDim    = Color3.fromRGB(160, 160, 165),
    Stroke     = Color3.fromRGB(90, 90, 96),
}

-- Traduce un color del tema viejo al nuevo. Si el color no pertenece a
-- ninguna paleta conocida (ej. el negro fijo de acento, o el blanco fijo
-- de un texto sobre fondo oscuro), se devuelve sin cambios.
local function swapThemeColor(color, toDark)
    local fromPalette = toDark and LightPalette or DarkPalette
    local toPalette = toDark and DarkPalette or LightPalette
    for key, value in pairs(fromPalette) do
        if color == value then
            return toPalette[key]
        end
    end
    return color
end

