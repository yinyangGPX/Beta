-- Resetea el scroll de un ScrollingFrame a la esquina superior en el
-- siguiente frame. Se usa task.defer porque AutomaticCanvasSize a veces
-- termina de recalcular el tamaño del canvas un instante después de
-- agregar el elemento, y si se fija CanvasPosition antes de eso, no
-- "pega" (bug de Roblox). Al diferirlo, se aplica después de que el
-- canvas ya se recalculó.
local function resetScrollTop(scrollingFrame)
    task.defer(function()
        if scrollingFrame and scrollingFrame.Parent then
            scrollingFrame.CanvasPosition = Vector2.new(0, 0)
        end
    end)
end

