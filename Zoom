getgenv().YYBuildPCEmoteChanger = function()
    --// Modo PC: reemplaza el grid táctil por un cambiador de emote visual.
    --// La lógica de clonación se mantiene aislada dentro de esta pestaña.
    EmoteState.enabled = false

    trackEmoteInstance(TabEmote:CreateLabel("CAMBIADOR VISUAL DE EMOTES", "VISUAL EMOTE CHANGER", 16))
    trackEmoteInstance(TabEmote:CreateLabel(
        "Escribe el nombre del emote actual y el emote visual que quieres usar.",
        "Enter the current emote name and the visual emote you want to use.",
        11
    ))
    trackEmoteInstance(TabEmote:CreateDivider())

    local targetEmoteName = ""
    local sourceEmoteName = ""
    local statusLabel

    function trimName(value)
        value = tostring(value or "")
        return value:gsub("^%s+", ""):gsub("%s+$", "")
    end

    function setStatus(text, color)
        if statusLabel and statusLabel.Parent then
            statusLabel.Text = text
            statusLabel.TextColor3 = color
        end
    end

    function createNameBox(titleSpanish, titleEnglish, placeholderSpanish, placeholderEnglish, setter)
        trackEmoteInstance(TabEmote:CreateLabel(titleSpanish, titleEnglish, 12))

        local input = Instance.new("TextBox")
        input.Name = "PCEmoteNameInput"
        input.Parent = TabEmote.Page
        input.Size = UDim2.new(1, 0, 0, 42)
        input.BackgroundColor3 = TabEmote.Button.BackgroundColor3
        input.BackgroundTransparency = 0.08
        input.BorderSizePixel = 0
        input.ClearTextOnFocus = false
        input.Font = Enum.Font.Gotham
        input.PlaceholderText = placeholderSpanish
        input.PlaceholderColor3 = Color3.fromRGB(165, 170, 185)
        input.Text = ""
        input.TextColor3 = Color3.fromRGB(245, 245, 250)
        input.TextSize = 14
        input.TextXAlignment = Enum.TextXAlignment.Left
        input.TextTruncate = Enum.TextTruncate.AtEnd
        input.ZIndex = 10

        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 14)
        padding.PaddingRight = UDim.new(0, 14)
        padding.Parent = input

        local inputCorner = Instance.new("UICorner")
        inputCorner.CornerRadius = UDim.new(0, 8)
        inputCorner.Parent = input

        local inputStroke = Instance.new("UIStroke")
        inputStroke.Color = Color3.fromRGB(120, 125, 145)
        inputStroke.Thickness = 1
        inputStroke.Transparency = 0.42
        inputStroke.Parent = input

        input:SetAttribute("ThemeRole", "Secondary")
        input:SetAttribute("ThemeTextRole", "Text")
        input:SetAttribute("PlaceholderSpanish", placeholderSpanish)
        input:SetAttribute("PlaceholderEnglish", placeholderEnglish)
        inputStroke:SetAttribute("ThemeRole", "Stroke")

        input.Focused:Connect(function()
            inputStroke.Transparency = 0.05
            inputStroke.Thickness = 1.5
        end)
        input.FocusLost:Connect(function()
            inputStroke.Transparency = 0.42
            inputStroke.Thickness = 1
        end)
        input:GetPropertyChangedSignal("Text"):Connect(function()
            setter(trimName(input.Text))
        end)
        trackEmoteInstance(input)
        return input
    end

    createNameBox(
        "EMOTE ACTUAL / TARGET",
        "CURRENT EMOTE / TARGET",
        "Ejemplo: Popular",
        "Example: Popular",
        function(value) targetEmoteName = value end
    )

    createNameBox(
        "EMOTE VISUAL / SOURCE",
        "VISUAL EMOTE / SOURCE",
        "Ejemplo: Broom of Doom",
        "Example: Broom of Doom",
        function(value) sourceEmoteName = value end
    )

    trackEmoteInstance(TabEmote:CreateDivider())

    function findEmoteFolder(name)
        local rep = game:GetService("ReplicatedStorage")
        local cleanName = trimName(name)
        if cleanName == "" then return nil end

        local folder = rep:FindFirstChild(cleanName, true)
        if folder then return folder end

        local compactName = cleanName:gsub("%s+", "")
        if compactName ~= cleanName then
            folder = rep:FindFirstChild(compactName, true)
        end
        return folder
    end

    function applyVisualEmote()
        local targetName = trimName(targetEmoteName)
        local sourceName = trimName(sourceEmoteName)
        if targetName == "" or sourceName == "" then
            setStatus("Faltan los dos nombres de emote.", Color3.fromRGB(255, 185, 115))
            return
        end

        local targetFolder = findEmoteFolder(targetName)
        local sourceFolder = findEmoteFolder(sourceName)
        if not targetFolder then
            setStatus("No se encontró el emote actual: " .. targetName, Color3.fromRGB(255, 125, 125))
            return
        end
        if not sourceFolder then
            setStatus("No se encontró el emote visual: " .. sourceName, Color3.fromRGB(255, 125, 125))
            return
        end
        if targetFolder == sourceFolder then
            setStatus("El emote actual y el visual deben ser diferentes.", Color3.fromRGB(255, 185, 115))
            return
        end

        --// Preparar clones antes de destruir el target: evita dejarlo vacío si
        --// algún elemento no puede clonarse en el cliente actual.
        local clones = {}
        for _, item in ipairs(sourceFolder:GetChildren()) do
            local ok, clonedItem = pcall(function()
                return item:Clone()
            end)
            if not ok or not clonedItem then
                for _, pending in ipairs(clones) do
                    pcall(function() pending:Destroy() end)
                end
                setStatus("No se pudo preparar el emote visual.", Color3.fromRGB(255, 125, 125))
                return
            end
            table.insert(clones, clonedItem)
        end

        for _, item in ipairs(targetFolder:GetChildren()) do
            pcall(function() item:Destroy() end)
        end
        for _, clonedItem in ipairs(clones) do
            clonedItem.Parent = targetFolder
        end

        setStatus("Aplicado: " .. targetName .. " → " .. sourceName, Color3.fromRGB(150, 255, 190))
        print("✅ PC VISUAL EMOTE: " .. targetName .. " → " .. sourceName)
    end

    trackEmoteInstance(TabEmote:CreateButton(
        "APLICAR EMOTE VISUAL",
        "APPLY VISUAL EMOTE",
        applyVisualEmote
    ))

    statusLabel = trackEmoteInstance(TabEmote:CreateLabel(
        "Listo para aplicar un cambio visual.",
        "Ready to apply a visual change.",
        11
    ))
    statusLabel.TextColor3 = Color3.fromRGB(175, 185, 205)
    statusLabel.TextWrapped = true
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel:SetAttribute("ThemeTextRole", "TextDim")

    UI.PCEmoteChanger = true
end

getgenv().YYIsPCEmotePlatform = function()
    local detector = UI and UI.DetectPlatformType
    if type(detector) == "function" then
        local ok, result = pcall(detector)
        if ok then
            return result == "PC"
        end
    end

    local isPC = false
    pcall(function()
        local userInputService = game:GetService("UserInputService")
        local preferredInput = userInputService.PreferredInput
        if preferredInput == Enum.PreferredInput.KeyboardAndMouse then
            isPC = true
            return
        elseif preferredInput == Enum.PreferredInput.Touch then
            return
        end

        local hasKeyboard = userInputService.KeyboardEnabled
        local hasMouse = userInputService.MouseEnabled
        local hasTouch = userInputService.TouchEnabled
        if hasKeyboard and hasMouse and not hasTouch then
            isPC = true
            return
        end

        local camera = workspace.CurrentCamera
        local viewportWidth = camera and camera.ViewportSize.X or 0
        isPC = viewportWidth >= 1080
    end)
    return isPC
end

