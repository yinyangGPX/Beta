--// ═════════════════════════════════════════════════════════════════════════════
--// FIGURE-8 LOOP (Lemniscata — Movimiento en bucle ∞)
--// Traza una lemniscata de Bernoulli (símbolo ∞) alrededor del punto exacto
--// donde el toggle fue activado. El personaje queda anclado en Y y sigue
--// siempre la tangente de la curva, mirando en la dirección del movimiento.
--// Velocidad y radio son configurables en tiempo real vía sliders en TabOptions.
--// ═════════════════════════════════════════════════════════════════════════════

local figure8T            = 0      -- Parámetro de la curva (radianes, crece indefinidamente)
local figure8CenterCF     = nil    -- CFrame congelado del punto de activación
local figure8Conn         = nil    -- Conexión Heartbeat activa
local figure8PrevAnchor   = false  -- Estado Anchored previo del HRP
local figure8PrevWalkSpd  = 16     -- WalkSpeed previo del Humanoid

function StopFigure8Loop()
    -- Desconectar el loop si existe
    if figure8Conn then
        figure8Conn:Disconnect()
        figure8Conn = nil
    end
    -- Restaurar estado previo del personaje
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = figure8PrevWalkSpd end
    end
    figure8CenterCF = nil
    print("❌ Figure-8 Loop STOPPED")
end

function StartFigure8Loop()
    StopFigure8Loop()  -- Garantiza que no haya loop previo colgado

    local char = LocalPlayer.Character
    if not char then
        warn("[Figure-8] No character found")
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        warn("[Figure-8] HumanoidRootPart or Humanoid not found")
        return
    end

    -- Guardar estado previo antes de modificar nada
    figure8PrevAnchor  = hrp.Anchored
    figure8PrevWalkSpd = hum.WalkSpeed

    -- Inmovilizar sin anclar — el CFrame se replica a todos los jugadores
    hum.WalkSpeed  = 0
    figure8T       = 0

    -- Capturar el CFrame de origen:
    -- posición actual del personaje + orientación de su cara (solo eje Y)
    local lookVec = hrp.CFrame.LookVector
    figure8CenterCF = CFrame.new(hrp.Position)
        * CFrame.Angles(0, math.atan2(lookVec.X, lookVec.Z), 0)

    print("✅ Figure-8 Loop STARTED at " .. tostring(hrp.Position))

    figure8Conn = RunService.Heartbeat:Connect(function(dt)
        if not Config.EnableFigure8 then return end

        local char2 = LocalPlayer.Character
        if not char2 then return end
        local hrp2 = char2:FindFirstChild("HumanoidRootPart")
        if not hrp2 then return end

        -- ──────────────────────────────────────────────────────────────────────
        -- Lemniscata de Bernoulli parametrizada (plano XZ local):
        --   x(t) = R · cos(t)            → eje lateral   (RightVector)
        --   z(t) = (R/2) · sin(2·t)      → eje frontal   (LookVector)
        -- Derivadas → dirección del movimiento (tangente):
        --   dx/dt = −R · sin(t)
        --   dz/dt =  R · cos(2·t)
        -- ──────────────────────────────────────────────────────────────────────
        figure8T = figure8T + Config.Figure8Speed * dt

        local R  = Config.Figure8Radius
        local t  = figure8T

        local localX =  R       * math.cos(t)
        local localZ = (R * 0.5)* math.sin(2 * t)
        local tanX   = -R       * math.sin(t)
        local tanZ   =  R       * math.cos(2 * t)

        -- Transformar al espacio mundial usando los vectores del punto de activación
        local right   = figure8CenterCF.RightVector
        local forward = figure8CenterCF.LookVector
        local origin  = figure8CenterCF.Position

        local worldPos = origin + right * localX + forward * localZ
        -- Mantener la altura Y exacta del punto de activación (sin caída)
        worldPos = Vector3.new(worldPos.X, origin.Y, worldPos.Z)

        -- Dirección hacia la que mira el personaje = tangente de la curva en espacio mundial
        local worldTan = right * tanX + forward * tanZ
        local tanMag   = worldTan.Magnitude

        local newCF
        if tanMag > 0.01 then
            newCF = CFrame.new(worldPos, worldPos + worldTan)
        else
            -- Singularidad (velocidad tangente cero): mantener dirección del origen
            newCF = CFrame.new(worldPos, worldPos + forward)
        end

        hrp2.CFrame = newCF
        -- Zeroing de velocidad: evita que la física acumule momentum entre frames
        hrp2.AssemblyLinearVelocity  = Vector3.zero
        hrp2.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- Si el personaje reaparece mientras el loop está activo, desactivarlo para
-- evitar que intente mover el nuevo personaje desde coordenadas del mapa anterior.
LocalPlayer.CharacterAdded:Connect(function()
    if Config.EnableFigure8 then
        Config.EnableFigure8 = false
        StopFigure8Loop()
        print("[Figure-8] Character respawned — loop deactivated automatically")
    end
end)

