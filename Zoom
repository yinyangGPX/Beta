    sourceEmoteName = value
end)

TabEmotes:CreateButton("Aplicar Emote", function()
    if targetEmoteName == "" or sourceEmoteName == "" then
        print("[Emotes] Completá los dos nombres de emote antes de aplicar.")
        return
    end

    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local targetFolder = ReplicatedStorage:FindFirstChild(targetEmoteName, true)
    local sourceFolder = ReplicatedStorage:FindFirstChild(sourceEmoteName, true)

    if not targetFolder then
        print("[Emotes] No se encontró el emote actual: " .. targetEmoteName)
        return
    end
    if not sourceFolder then
        print("[Emotes] No se encontró el emote a copiar: " .. sourceEmoteName)
        return
    end

    for _, item in ipairs(targetFolder:GetChildren()) do
        item:Destroy()
    end
    for _, item in ipairs(sourceFolder:GetChildren()) do
        local clonedItem = item:Clone()
        clonedItem.Parent = targetFolder
    end

    print("[Emotes] Emote " .. targetEmoteName .. " reemplazado por " .. sourceEmoteName)
end)

