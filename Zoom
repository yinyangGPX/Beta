        -- El callback recibe SIEMPRE la lista completa de seleccionados.
        function Tab:CreateMultiDropdown(text, options, defaults, callback)
            options = options or {}
            local selectedSet = {}
            if defaults then
                for _, v in ipairs(defaults) do selectedSet[v] = true end
