        pcall(function()
            local name = e.data.name
            local url  = e.data.url

            -- Caché en disco: si ya existe, saltar descarga.
            local cachedOk, exists = pcall(isfile, name)
            if not (cachedOk and exists) then
                local dlOk, data = pcall(game.HttpGet, game, url, true)
                if not dlOk or type(data) ~= "string" or #data < 100 then
                    if e.icon and e.icon.Parent then
                        e.icon.Text = T("Error de carga", "Load error")
                    end
                    return
                end
                local writeOk = pcall(writefile, name, data)
                if not writeOk then
                    if e.icon and e.icon.Parent then
                        e.icon.Text = T("Error de caché", "Cache error")
                    end
                    return
                end
            end

            -- Convertir a asset compatible con Roblox.
            local aOk, aid = pcall(getcustomasset, name)
            if aOk and type(aid) == "string" and aid ~= "" then
                if e.il and e.il.Parent then
                    e.il.Image = aid
                    e.il.ImageTransparency = 0
                    pcall(function() e.icon:Destroy() end)
                end
            else
                if e.icon and e.icon.Parent then
                    e.icon.Text = T("Error de carga", "Load error")
                end
            end
        end)
    end
end)

