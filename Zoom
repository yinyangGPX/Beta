-- PESTAÑA EMOTES — misma lógica que visual_emote_changer_lua:
-- busca dos carpetas por nombre dentro de ReplicatedStorage (búsqueda
-- recursiva), vacía la carpeta del emote actual y le clona adentro
-- el contenido de la carpeta del emote elegido.
-- ============================================================
local TabEmotes = Zero:CreateTab("Emots",
    "https://raw.githubusercontent.com/xonokeo-art/Rozek/main/BackgroundEraser_20260923_000706342.png")

