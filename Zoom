        -- Descarga una imagen desde una URL externa y la muestra dentro de la
        -- pestaña. Usa el mismo patrón de caché que ya usa Zin para audio
        -- (isfile -> game:HttpGet -> writefile -> getcustomasset), no uno
        -- inventado. Si el ejecutor no soporta esas funciones, se avisa con
        -- texto en vez de fallar en silencio.
        function Tab:CreateRemoteImage(imageUrl, cacheFileName, imageHeight)
            imageHeight = imageHeight or 200
            local Card = mk("Frame", {
                Parent = TabPage,
                Size = UDim2.new(1, 0, 0, imageHeight + 34),
                BackgroundColor3 = Theme.Secondary,
                ZIndex = 9
            })
            corner(Card, 8)
            stroke(Card, Color3.fromRGB(0, 0, 0), 1, 0.6)
            mk("UIPadding", {
                PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
                PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)
            }, Card)

            local StatusLabel = mk("TextLabel", {
                Parent = Card,
                Size = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1,
                Text = "Descargando imagen...",
                Font = Theme.Font,
                TextSize = 12,
                TextColor3 = Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 10
            })

            local ImageFrame = mk("ImageLabel", {
                Parent = Card,
                Size = UDim2.new(1, 0, 0, imageHeight),
                Position = UDim2.new(0, 0, 0, 22),
                BackgroundColor3 = Color3.fromRGB(0, 0, 0),
                BackgroundTransparency = 0.5,
                Image = "",
                ScaleType = Enum.ScaleType.Fit,
                ZIndex = 10
            })
            corner(ImageFrame, 6)

            task.spawn(function()
                if type(writefile) ~= "function" or type(isfile) ~= "function" or type(readfile) ~= "function" then
                    StatusLabel.Text = "Este ejecutor no soporta writefile/isfile — no se puede cachear la imagen."
                    return
                end

                local cachedOk, cachedExists = pcall(isfile, cacheFileName)
                if not (cachedOk and cachedExists) then
                    local downloadOk, data = pcall(function()
                        return game:HttpGet(imageUrl, true)
                    end)
                    if not downloadOk or type(data) ~= "string" or #data < 10 then
                        StatusLabel.Text = "No se pudo descargar la imagen (falló game:HttpGet)."
                        return
                    end
                    local writeOk = pcall(writefile, cacheFileName, data)
                    if not writeOk then
                        StatusLabel.Text = "No se pudo guardar la imagen en el dispositivo (writefile falló)."
                        return
                    end
                end

                if type(getcustomasset) ~= "function" then
                    StatusLabel.Text = "Este ejecutor no tiene getcustomasset — la imagen quedó descargada pero no se puede mostrar."
                    return
                end

                local assetOk, assetResult = pcall(getcustomasset, cacheFileName)
                if not (assetOk and type(assetResult) == "string") then
                    StatusLabel.Text = "Imagen descargada, pero getcustomasset falló — no se puede mostrar."
                    return
                end

                ImageFrame.Image = assetResult
                StatusLabel.Visible = false
                ImageFrame.Position = UDim2.new(0, 0, 0, 0)
            end)

            resetScrollTop(TabPage)
            return Card
        end

        return Tab
    end

    local isDarkMode = false
    function Window:SetDarkMode(enabled)
        if enabled == isDarkMode then return end
        isDarkMode = enabled

        Theme.Background = enabled and DarkPalette.Background or LightPalette.Background
        Theme.Secondary  = enabled and DarkPalette.Secondary  or LightPalette.Secondary
        Theme.AccentOff  = enabled and DarkPalette.AccentOff  or LightPalette.AccentOff
        Theme.Text       = enabled and DarkPalette.Text       or LightPalette.Text
        Theme.TextDim    = enabled and DarkPalette.TextDim    or LightPalette.TextDim
        Theme.Stroke     = enabled and DarkPalette.Stroke     or LightPalette.Stroke

        for _, obj in ipairs(Main:GetDescendants()) do
            if obj:IsA("GuiObject") then
                local ok, bg = pcall(function() return obj.BackgroundColor3 end)
                if ok then
                    obj.BackgroundColor3 = swapThemeColor(bg, enabled)
                end
            end
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                obj.TextColor3 = swapThemeColor(obj.TextColor3, enabled)
            end
            if obj:IsA("UIStroke") then
                obj.Color = swapThemeColor(obj.Color, enabled)
            end
        end
    end

    function Window:IsDarkMode()
        return isDarkMode
    end

    function Window:Destroy()
        for _, conn in ipairs(globalConnections) do
            pcall(function() conn:Disconnect() end)
        end
        ScreenGui:Destroy()
    end

    return Window
end

